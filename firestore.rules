rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Staff checks
    function isStaff() {
      return isSignedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isStaff() && staffData().role == 'super_admin';
    }

    function isAdministrator() {
      return isStaff() && (staffData().role == 'super_admin' || staffData().role == 'admin');
    }

    // Customer ownership
    function isCustomerOwner(customerId) {
      return isSignedIn() && (request.auth.uid == customerId || (resource != null && resource.data.customerId == request.auth.uid));
    }

    // 1. Staff Collection
    match /staff/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isSuperAdmin() || (!exists(/databases/$(database)/documents/staff/$(uid)) && request.auth.uid == uid);
    }

    // 2. Packages Collection (Publicly readable, configurable by Admins)
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdministrator();
    }

    // 3. Enquiries Collection (Public lead capture, staff managed)
    match /enquiries/{enquiryId} {
      allow create: if incoming().name is string && incoming().email is string;
      allow read, update, delete: if isStaff();
    }

    // 4. Customers Collection (Staff management + customer self-read)
    match /customers/{customerId} {
      allow read: if isStaff() || isCustomerOwner(customerId);
      allow create, update, delete: if isStaff();
    }

    // 5. Website Projects Collection
    match /websiteProjects/{projectId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create, update, delete: if isStaff();
    }

    // 6. Website Content Collection (Shared Dynamic Engine data)
    match /websiteContent/{customerId} {
      allow read: if true; // Publicly readable for rendering live websites
      allow create, update: if isStaff() || isCustomerOwner(customerId);
      allow delete: if isAdministrator();
    }

    // 7. Customer Cloud Documents (Multi-tenant isolated)
    match /documents/{documentId} {
      allow read: if isCustomerOwner(resource.data.customerId) || isStaff();
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId) || isAdministrator();
    }

    // 8. Customer Cloud Pictures (Multi-tenant isolated)
    match /pictures/{pictureId} {
      allow read: if isCustomerOwner(resource.data.customerId) || isStaff() || (resource != null && resource.data.isWebsiteAsset == true);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId) || isAdministrator();
    }

    // 9. Customer Tasks
    match /tasks/{taskId} {
      allow read: if isCustomerOwner(resource.data.customerId);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId);
    }

    // 10. Customer Activities
    match /activities/{activityId} {
      allow read: if isCustomerOwner(resource.data.customerId);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId);
    }

    // 11. Customer Calendar Events
    match /calendarEvents/{eventId} {
      allow read: if isCustomerOwner(resource.data.customerId);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId);
    }

    // 12. Customer Notes
    match /notes/{noteId} {
      allow read: if isCustomerOwner(resource.data.customerId);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId);
    }

    // 13. Customer Goals
    match /goals/{goalId} {
      allow read: if isCustomerOwner(resource.data.customerId);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
      allow update, delete: if isCustomerOwner(resource.data.customerId);
    }

    // 14. Customer Store Configuration (My Store Add-on)
    match /stores/{storeId} {
      allow read: if true; // Public store catalog preview
      allow create, update: if isCustomerOwner(resource.data.customerId) || isStaff();
      allow delete: if isAdministrator();
    }

    // 15. Store Products
    match /products/{productId} {
      allow read: if true; // Public store viewing
      allow create, update, delete: if (isSignedIn() && incoming().customerId == request.auth.uid) || isStaff();
    }

    // 16. Activity & Audit Logs
    match /activityLogs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
